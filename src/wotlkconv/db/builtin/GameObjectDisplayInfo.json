      "from": "GeoBox",
      "array_index": 1
    },
    {
      "target": [
        "GeoBoxMin"
      ],
      "target_array_index": 2,
      "type": "float",
      "from": "GeoBox",
      "array_index": 2
    },
    {
      "target": [
        "GeoBoxMax"
      ],
      "target_array_index": 0,

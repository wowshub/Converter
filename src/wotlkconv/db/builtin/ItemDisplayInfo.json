{
  "table": "ItemDisplayInfo",
  "description": "Models, textures and icon for an equippable item. Modern builds keep none of these on the row, so every name is joined from ModelFileData, TextureFileData, ItemDisplayInfoMaterialRes and ItemAppearance (see wotlkconv/db/itemdisplay.py for the rules and their measured agreement with a clean 3.3.5a client). ItemVisual and ParticleColorID map themselves by name.",
  "id_offset_columns": [
    "ID"
  ],
  "requires_tables": [
    "ModelFileData",
    "ComponentModelFileData",
    "TextureFileData",
    "ComponentTextureFileData",
    "ItemDisplayInfoMaterialRes",
    "ItemAppearance",
    "ItemModifiedAppearance",
    "Item",
    "ItemRangedDisplayInfo",
    "ChrRaces"
  ],
  "columns": [
    {
      "target": [
        "ModelName"
      ],
      "target_array_index": 0,
      "type": "string",
      "resolve": "itemdisplay.model",
      "args": {
        "index": 0
      },
      "note": "bare file name with .mdx; helmets without their race/gender suffix"
    },
    {
      "target": [
        "ModelName"
      ],
      "target_array_index": 1,
      "type": "string",
      "resolve": "itemdisplay.model",
      "args": {
        "index": 1
      }
    },
    {
